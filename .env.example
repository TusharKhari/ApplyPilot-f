# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one or more for cascade fallback)
GEMINI_API_KEY=           # Gemini 2.5 Flash (recommended, free tier)
# NVIDIA_API_KEY=         # NVIDIA NIM (moonshotai/kimi-k3 / Kimi-K3)
# DEEPSEEK_API_KEY=       # DeepSeek (deepseek-flash / DeepSeek-V4.1-Flash)
# OPENAI_API_KEY=         # OpenAI (gpt-4.1-mini)
# ANTHROPIC_API_KEY=      # Anthropic (claude-haiku-4-5)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name (e.g. moonshotai/kimi-k3, deepseek-flash)

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
